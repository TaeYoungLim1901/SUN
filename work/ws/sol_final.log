# exact bounded quadratic min: if convex and vertex inside use vertex; otherwise lower of endpoints
p2=betas[:,2]; vr=vv.copy(); vlo=np.full(len(vr),.2); vhi=np.full(len(vr),.3)
flo=betas[:,0]+betas[:,1]*.2+betas[:,2]*.04
