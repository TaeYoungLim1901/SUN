# At vertex, predicted improvement vs .25 and its delta-method conditional wrt betas including v derivative effect envelope theorem: diff=f(.25)-f(vhat); grad = x(.25)-x(vhat) (derivative wrt v vanishes at optimum)
d=np.array([1,.25,.25**2])-np.array([1,v,v*v])
print('gain',(d@beta),'se_gain',np.sqrt(d@cov@d))
# monte carlo unbounded and restricted local [.2,.3]
rng=np.random.default_rng(1); ys=y+rng.normal(0,sig,(1000000,3)); betas=ys@np.linalg.inv(X).T # wait row y @ inv(X).T because beta=invX y
vv=-betas[:,1]/(2*betas[:,2])
print(np.quantile(vv[np.isfinite(vv)],[.025,.5,.975]),np.std(vv[(vv>-1)&(vv<1)]))
# optimize grid or boundaries [.2,.3]
grid=np.linspace(.2,.3,1001)
preds=betas[:,0,None]+betas[:,1,None]*grid+betas[:,2,None]*grid**2
ii=np.argmin(preds,axis=1);vo=grid[ii];gain=ys[:,1]-preds[np.arange(len(ys)),ii]
print('bounded v mean sd qs',vo.mean(),vo.std(),np.quantile(vo,[.025,.5,.975]))
print('bounded gain',gain.mean(),gain.std(),np.quantile(gain,[.025,.5,.975]))
