def stony_grid(px, lim=72.0):
    """(lon, lat) 등간격 격자를 원반 좌표로 되돌리는 grid_sample 격자. B0≈0 근사 (DOMAIN §9.1)."""
    a = torch.linspace(-lim, lim, px, device=DEV) * math.pi / 180.0
    lat, lon = torch.meshgrid(a, a, indexing="ij")
    gx = 0.94 * torch.cos(lat) * torch.sin(lon)      # 원반 반지름 0.47*PX = 정규좌표 0.94
    gy = 0.94 * torch.sin(lat)
    return torch.stack([gx, gy], dim=-1)[None]       # (1,px,px,2)


